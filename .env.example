# The MVP runs entirely in the browser and needs NO environment variables.
#
# These are only for the future Supabase backend (see docs/supabase-schema.sql).
# Copy to .env and fill in from your Supabase project settings. Only the anon
# (public) key belongs in the frontend — never the service_role key (PRD 11).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Next.js reads NEXT_PUBLIC_* (Vite reads VITE_*). During the migration, set BOTH
# to the same values so the app works under either build. The env shim in
# src/lib/env-public.ts reads whichever is present. Only the anon key belongs
# client-side — never the service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SEO / site configuration (all OPTIONAL — safe production defaults are used
# when unset, so nothing here is required for the app to run). Only public
# NEXT_PUBLIC_* values belong here; never put secrets in the client bundle.
# ---------------------------------------------------------------------------
# Absolute site origin used for canonical URLs, OpenGraph and the sitemap.
# Defaults to the production domain; set per environment (e.g. a preview URL).
NEXT_PUBLIC_SITE_URL=
# Override the product/site name and default meta description (optional).
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_DESCRIPTION=
# Search-engine verification tokens (from Search Console / Bing / Yandex).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX). Analytics is a no-op
# and loads ZERO third-party JS when this is unset.
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Google reCAPTCHA v2 ("I'm not a robot" checkbox + image puzzles) — bot
# protection on the login, sign-up and password-reset forms. Create a reCAPTCHA
# v2 "Checkbox" site at https://www.google.com/recaptcha/admin/create — it yields
# a SITE key (public, safe in the browser) and a SECRET key (server-only). Add
# your domain(s), e.g. mymachineshopmanager.vercel.app and localhost.
#
# Enforcement is done by OUR server: Supabase cannot verify reCAPTCHA, so the
# /api/auth/{login,signup,forgot} routes verify the token with Google (holding
# the SECRET) BEFORE touching Supabase. Do NOT put the secret in the client. When
# the SITE key below is unset the whole feature is a graceful no-op (no widget,
# no gating), so existing deployments keep working until it is provisioned.
#
# Local testing without risk: Google's public test keys (ALWAYS pass, show a
# "for testing only" banner) are:
#   SITE  : 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#   SECRET: 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# ---------------------------------------------------------------------------
# Public widget (site) key — safe to expose to the browser.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret key — ONLY for server-side verification (src/server/recaptcha.ts via the
# /api/auth/* routes). Never expose this to the client.
RECAPTCHA_SECRET_KEY=

# --- Razorpay (subscription checkout) ---
# Test mode: rzp_test_* ; Live mode: rzp_live_* (just swap these two, no code change).
# Server-only. The key id is returned to the client for the checkout widget; the
# secret is used only on the server for order creation + signature verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
